{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huiro",
  "version": "0.1.0",
  "identifier": "ru.listok.board",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": "./app-data",
    "windows": [
      {
        "label": "main",
        "title": "Huiro",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}

