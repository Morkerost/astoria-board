{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Доступ только к данным переносимой доски",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-read-file",
    "fs:allow-read-text-file"
  ]
}

